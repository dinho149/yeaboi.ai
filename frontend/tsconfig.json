{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // "node" is here only so vite.config.ts can use import.meta.dirname; no
    // node API is reachable from src/ — those bundles run in a browser.
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Preact via preact/compat — the alias lives in vite.config.ts; this is the
    // matching half so `tsc` resolves the same modules the bundler does.
    // Application code therefore imports from "react" like any React codebase;
    // swapping preact back out is a change to these two blocks and nothing else.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@contracts/*": ["../contracts/web/*"],
      "react-dom/client": ["./node_modules/preact/compat/client"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"],
      "react": ["./node_modules/preact/compat/"],
      "react-dom": ["./node_modules/preact/compat/"]
    },

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts"]
}
