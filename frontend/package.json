{
  "name": "yeaboi-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Front-end bundles for yeaboi's exported and tunnel-served pages. Built output is committed to src/yeaboi/web/static so installing yeaboi never needs Node.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build-all.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
