# LLM Provider
# Options: anthropic (default), openai, google, bedrock, ollama
# Install additional providers: uv sync --extra openai / --extra google / --extra bedrock / --extra ollama
LLM_PROVIDER=anthropic
# Optional: override the default model for the selected provider
# Anthropic default: claude-sonnet-4-6
# OpenAI default:    gpt-4o
# Google default:    gemini-2.5-flash
# Bedrock default:   us.anthropic.claude-sonnet-4-6-v1:0
# Ollama default:    qwen3:8b
LLM_MODEL=

# Anthropic (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key

# Google AI (required when LLM_PROVIDER=google)
GOOGLE_API_KEY=your-google-api-key

# Ollama (local, no API key — free & private; see README "Local Mode (Ollama)")
# Install Ollama from https://ollama.com, then: ollama pull qwen3:8b
# Base URL of the local Ollama server (default shown)
OLLAMA_BASE_URL=http://localhost:11434
# Context window requested from the model (default 16384 — the server's own
# 2-4k default silently truncates yeaboi's larger planning prompts)
OLLAMA_NUM_CTX=16384

# LangSmith (optional — enables tracing for development)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=yeaboi

# GitHub (optional — enables repo context tools; required for private repos and higher rate limits)
# Fine-grained PAT: Contents=Read, Issues=Read, Metadata=Read (org must approve the token)
# Classic PAT: public_repo (public repos) or repo (private repos)
# No token: works for public repos at 60 req/hour (unauthenticated)
# Org uses SAML/SSO? A classic PAT needs a separate step after creating it:
# github.com/settings/tokens -> "Configure SSO" next to the token -> Authorize.
# Skipping this is the #1 cause of "access denied ... needs the 'repo' scope,
# and SSO authorisation if the org requires it" even with a correctly-scoped token.
GITHUB_TOKEN=your-github-personal-access-token

# Azure DevOps (optional — enables repo context tools and board sync; required for private projects)
# PAT permissions needed: Code=Read, Work Items=Read+Write, Project=Read
AZURE_DEVOPS_TOKEN=your-azure-devops-personal-access-token
# Organization URL (e.g. https://dev.azure.com/myorg) — required for board sync
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
# Project name — required for board sync
AZURE_DEVOPS_PROJECT=MyProject
# Team name (optional — defaults to "{project} Team")
AZURE_DEVOPS_TEAM=

# Jira Cloud / Atlassian (optional — enables Jira board read + issue creation tools)
# API token: id.atlassian.com → Security → API tokens
# No trailing slash on JIRA_BASE_URL
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=MYPROJ

# Team analysis (optional — extra API calls to improve “Repository activity”)
# Jira: fetch dev-status (linked PRs/branches from Jira Software Development panel)
#TEAM_ANALYSIS_JIRA_DEV_LINKS=true
# Azure DevOps: scan recent Git PRs for work item links / id in branch name (per-repo cap)
#TEAM_ANALYSIS_AZDO_BRANCH_SEARCH=true
#TEAM_ANALYSIS_AZDO_PR_SEARCH_MAX_REPOS=10
#TEAM_ANALYSIS_AZDO_PR_SEARCH_PRS_PER_REPO=75
#TEAM_ANALYSIS_AZDO_REPO_ALLOWLIST=my-repo,other-repo
# Exhaustive Analysis-mode estate boundaries (comma-separated).
# Every repository/page within these configured containers is discovered.
# Owners are also settable in Settings → GitHub → Analysis Owners, and pickable
# per run in the Analysis setup wizard.
#TEAM_ANALYSIS_GITHUB_OWNERS=my-org,another-owner
#TEAM_ANALYSIS_AZDO_PROJECTS=MyProject,SharedPlatform
#TEAM_ANALYSIS_CONFLUENCE_SPACES=ENG,OPS
#TEAM_ANALYSIS_NOTION_ROOTS=page-id-1,page-id-2
# Maximum duration of one Analysis-mode AI enrichment request (10-600 seconds).
#TEAM_ANALYSIS_ENRICHMENT_TIMEOUT_SECONDS=120
# Optional exact model for lightweight Analysis coaching. Unset automatically
# uses Haiku / GPT-4o mini / Gemini Flash Lite for supported cloud providers.
# Set to "default" to keep the user's primary model for these calls.
#TEAM_ANALYSIS_FAST_MODEL=
# Target duration for the LLM portion of Deep analysis and maximum concurrent
# hosted-model requests. Ollama is always serialized to protect local throughput.
#TEAM_ANALYSIS_LLM_TARGET_SECONDS=600
#TEAM_ANALYSIS_LLM_MAX_CONCURRENCY=6
# Per-request documentation API deadline and per-provider body-read ceiling.
# Concurrency starts below this ceiling and adapts down on rate limits/timeouts.
#TEAM_ANALYSIS_DOC_REQUEST_TIMEOUT_SECONDS=30
#TEAM_ANALYSIS_DOC_MAX_CONCURRENCY=8
# Bounded read-only repository/activity requests used by Analysis mode (1-16).
#TEAM_ANALYSIS_CODE_MAX_CONCURRENCY=6

# Confluence (optional — documentation source)
# By default Confluence reuses the Jira Atlassian creds above (same account), so
# only the space key is new. To use Confluence WITHOUT Jira, set the standalone
# CONFLUENCE_* login below — these win over the JIRA_* vars when present.
# Space key is the short identifier visible in your Confluence space URL.
CONFLUENCE_SPACE_KEY=MYSPACE
#CONFLUENCE_BASE_URL=https://your-org.atlassian.net
#CONFLUENCE_EMAIL=you@example.com
#CONFLUENCE_API_TOKEN=your-atlassian-api-token
# Optional page the Export buttons nest Confluence reports under. Exports
# publish into CONFLUENCE_SPACE_KEY; blank groups them under an auto-created
# "🤙 yeaboi" page at the root of the space so all yeaboi docs stay together.
#CONFLUENCE_EXPORT_PARENT_PAGE_ID=

# Notion (optional — its own doc tool, independent of Jira/Confluence)
# Create an internal integration at https://www.notion.so/my-integrations, then
# share the pages/databases you want the agent to read with that integration.
NOTION_TOKEN=ntn_your-notion-integration-token
# Optional: a root page or database ID used as the default parent for created
# pages. Notion has no "space key"; search spans whatever the integration is granted.
NOTION_ROOT_PAGE_ID=
# Optional dedicated page the Export buttons publish Notion reports under —
# blank groups reports under an auto-created "yeaboi" page (🤙 icon) inside
# NOTION_ROOT_PAGE_ID (Notion export needs one of the two set).
#NOTION_EXPORT_PARENT_PAGE_ID=

# Storage
# Data home for everything yeaboi writes — exports, logs, sessions DB,
# scrum-docs… Default: ~/.yeaboi. Only .env itself always stays at
# ~/.yeaboi/.env. Editable in the TUI: Settings → Data Dir.
#YEABOI_HOME=

# Voice input (optional — double-tap Space in any text field to dictate)
# Transcription runs locally & offline via faster-whisper (works with ANY LLM
# provider, no API key). Nothing to install by hand: the first double-tap offers
# to set it up in place (or run: yeaboi --install-voice).
# (self-contained on macOS/Windows; Linux also needs: apt install libportaudio2).
# VOICE_MODEL is the local Whisper model size, not a cloud model name.
# Options: tiny, base (default), small, medium, large-v3 (+ .en variants).
# Larger = more accurate but slower and a bigger one-time download.
VOICE_MODEL=base

# VOICE_DEVICE picks WHICH microphone dictation records from. PortAudio's system
# default is often not the one you mean (a laptop lid mic over your headset, say).
# Accepts a device index (2) or a case-insensitive part of its name (shure).
# Empty = the system default, which is how voice behaved before this setting.
# List what this machine has: yeaboi --list-audio-devices
# Or pick it with a live level test in Settings -> Voice Input -> Input Device.
VOICE_DEVICE=

# VOICE_INSTALL_OFFER controls whether double-tapping Space may offer to install
# dictation. Set to "off" by pressing n at the offer; set it back to "on" here or
# in Settings -> Voice Input. YEABOI_FORCE_VOICE_OFFER=1 overrides an "off" for
# one run, so the prompt can be demoed without editing this file.
VOICE_INSTALL_OFFER=on

# On-screen tips
# Rotating discoverability tips on the welcome screen + inline voice hints.
# Default on; set to false to hide all tips. Toggle live by pressing "t" on the
# welcome screen (the choice is saved back here automatically).
TIPS_ENABLED=true

# Beta notices — two separate mechanisms, one per surface.
#
# CLI only: the one-line maturity caveat printed to stderr before a beta
# subcommand runs (e.g. `yeaboi perf`). Default on; set false for cron/CI that
# captures stderr. This does NOT affect the TUI's one-time notice.
BETA_NOTICES_ENABLED=true
#
# TUI only: the one-time notice shown the first time a beta mode is opened.
# It has no on/off switch — it shows once, then never again. BETA_NOTICES_ACK
# records which modes have been acknowledged and is written automatically on
# Continue; it's state, not configuration, so don't hand-edit it. To see the
# notices again, clear it or set YEABOI_FORCE_BETA_NOTICE (1 for every mode, or
# a comma-separated list of mode keys).
# YEABOI_FORCE_BETA_NOTICE=1

# Session management
# Auto-prune sessions older than N days (default 30, set to 0 to disable)
SESSION_PRUNE_DAYS=30

# Logging
# Controls the file logger at ~/.yeaboi/logs/tui/yeaboi.log
# Values: DEBUG, INFO, WARNING (default), ERROR
# Set to DEBUG to capture full diagnostics for troubleshooting
LOG_LEVEL=WARNING

# ── Daily Standup mode ─────────────────────────────────────────────────
# Detects team activity (Jira/AzDO/GitHub/Confluence/local git), computes
# sprint day + confidence, and delivers a daily summary. Schedule time and
# delivery-channel selection are configured per-project in the Daily Standup
# TUI page (stored in SQLite); the values below are the shared secrets/creds.
#
# Your display name for your own standup update (default: "Me")
# STANDUP_USER_NAME=Omar
#
# GitHub code activity is scoped in the app: Standup -> Configure -> code sources
# picks the ORGANISATIONS/owners to cover (every active repo inside each), the
# same way Azure DevOps is picked by project. GITHUB_TOKEN above is all that is
# required. The setting below is the legacy single-repo pin, still honoured and
# still narrow — set it only to restrict the standup to exactly one repository.
# STANDUP_GITHUB_REPO=owner/repo
#
# Slack delivery — incoming webhook URL (https://api.slack.com/messaging/webhooks)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
#
# Slack two-way — a bot token turns delivery into a conversation. A webhook
# answers a POST with the literal body "ok" and no message id, so yeaboi cannot
# find its own message to read reactions on; chat.postMessage does, which is the
# whole reason a token is needed. Set neither and the webhook path is untouched.
# Bot token scopes: chat:write, channels:history (or groups:history for a
# private channel), reactions:read, users:read — plus reactions:write for
# yeaboi to tick a message it has acted on. Invite the app to the channel with
# /invite @yeaboi. Both must be set: posting as a bot changes the visible
# sender, so a token alone is not taken as consent to change how posts look.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123456789
#
# Who may act from Slack. A member id here is attributed by Slack's own
# servers, which is the first attested identity anything in yeaboi has had —
# and only as strong as the workspace, so keep the list small and curated.
# List the ids with `yeaboi slack members`. It fails closed three ways: empty
# means NOBODY (and the poll then never calls Slack at all), ONE malformed
# entry voids the whole list — a half-filled allowlist is the more dangerous
# state, because it looks configured — and the bot's own id is never
# authorised, or its acknowledgement reaction would authorise the next round.
# SLACK_ALLOWED_MEMBER_IDS=U0123456789,U0987654321
#
# Tick a message yeaboi has acted on. Off by default because it is the one
# thing here that needs a WRITE scope (reactions:write); with it unset, a
# correction is confirmed by a short line in the thread instead.
# SLACK_ACK_REACTION=white_check_mark
#
# Email delivery — SMTP settings
# STANDUP_SMTP_HOST=smtp.gmail.com
# STANDUP_SMTP_PORT=587
# STANDUP_SMTP_USER=you@example.com
# STANDUP_SMTP_PASSWORD=your-app-password
# STANDUP_SMTP_SENDER=you@example.com
# STANDUP_EMAIL_RECIPIENTS=teammate1@example.com,teammate2@example.com

# ─── Retro mode ─────────────────────────────────────────────────────────────
# The Retro page starts a small LAN web server so teammates can add cards from a
# browser. Base port to bind (walks upward if busy). Default: 5173.
# RETRO_PORT=5173
#
# "Share Remotely" opens a public Cloudflare tunnel for off-network teammates.
# The app auto-downloads cloudflared to ~/.yeaboi/bin/ (no account needed).
# Set this only to point at an existing cloudflared binary instead.
# CLOUDFLARED_PATH=/usr/local/bin/cloudflared
#
# Every Cloudflare share tunnel (Retro, Poker, and the generic "Share Online"
# flow used by Standup/Analysis/Performance/Reporting/Roadmap/Planning)
# auto-closes after this many minutes, so a forgotten open share doesn't stay
# internet-reachable forever. Default 60. Set to 0 to disable the timeout
# entirely — also adjustable from the TUI's Settings > System page.
TUNNEL_TIMEOUT_MINUTES=60
