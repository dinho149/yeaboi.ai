{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yeaboi-core/v1/standup.aggregate.json",
  "title": "standup.aggregate params and result",
  "description": "The deterministic middle of the DAILY STANDUP pipeline (the human mode), as one pure function: identity closure → roster filter → automation filter → coverage → grouping → insights → practices → confidence → member skeletons. DB-free by contract rule 5 (standup tables are report-history state): Python reads all session/config/history state and sends it as params; Python overlays LLM prose on the returned scaffold. Reference implementation: src/yeaboi/standup/aggregate.py::aggregate_standup (build_aggregate_inputs builds the params). Two-pass adjudication: pass 1 returns adjudication_cases; pass 2 repeats identical params plus dropped_case_ids and returns no cases. Member-keyed result objects keep MEMBERS order; nested objects keep the reference implementation's dict-literal key order (both are contractual — they feed the LLM prompt's json.dumps bytes).",
  "$defs": {
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string" }
    },
    "activity_item": {
      "type": "object",
      "description": "A raw collector item (params) or a projected item (result `grouped`; fixed key order: kind, title, summary, status, source, key, url, repository, timestamp, pr_id, branch, body, changed_paths, work_item_ids, work_items_known, issue_type, parent_key, subtask). Values pass through VERBATIM — a numeric pr_id stays numeric."
    },
    "params": {
      "type": "object",
      "required": ["bundle", "members", "my_name", "identity_extras", "self_reported_names", "config", "enabled_sources", "sprint", "history", "today", "want_adjudication"],
      "properties": {
        "bundle": {
          "type": "object",
          "required": ["items", "counts", "errors", "partial_sources", "skipped", "reference_tickets"],
          "properties": {
            "items": { "type": "array", "items": { "$ref": "#/$defs/activity_item" } },
            "counts": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 }, "description": "(source, count) pairs in collector order." },
            "errors": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
            "partial_sources": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
            "skipped": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
            "reference_tickets": { "type": "array", "items": { "$ref": "#/$defs/activity_item" }, "description": "Open tickets carried purely as matching context for the practice rules — never activity." }
          }
        },
        "members": { "type": "array", "items": { "type": "string" }, "description": "Pre-merge roster, the standup user first." },
        "my_name": { "type": "string" },
        "identity_extras": { "type": "array", "items": { "type": "string" }, "description": "Hoisted alias extras: parsed my_aliases + git identity + tracker identities + \"Me\"." },
        "self_reported_names": { "type": "array", "items": { "type": "string" } },
        "config": {
          "type": "object",
          "description": "Only the keys the deterministic layer reads; absent key → reader default.",
          "properties": {
            "automation_handling": { "type": "string" },
            "automation_markers": { "type": "string" },
            "habit_detection": { "type": "string" },
            "habit_rules": { "type": "string" }
          },
          "additionalProperties": false
        },
        "previous_report": {
          "type": ["object", "null"],
          "description": "Narrow projection of yesterday's report: member_updates[] of {name, summary, blockers, outlook, links, code_links, practices[].rule}."
        },
        "transcript_corrections": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "corrected_fields": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "description": "Pre-parsed edit-log fields per member (parsing needs yeaboi.artifacts.paths — Python-only)." },
        "feedback_excused": { "type": "array", "items": { "$ref": "#/$defs/pair" }, "description": "Sorted (rule, handle) pairs — the ledger's thumbs-down verdicts. Handles must match habits.change_handle byte-for-byte (semantics rule 11)." },
        "enabled_sources": { "type": "array", "items": { "type": "string" } },
        "sprint": {
          "type": "object",
          "required": ["sprint_name", "start_date", "sprint_length_weeks", "capacity_points", "completed_points"],
          "properties": {
            "sprint_name": { "type": "string" },
            "start_date": { "type": "string" },
            "sprint_length_weeks": { "type": "integer" },
            "capacity_points": { "type": "number", "description": "Already zeroed by Python when no live committed points were found." },
            "completed_points": { "type": "number" }
          }
        },
        "history": {
          "type": "array",
          "items": { "type": "object", "properties": { "status": {}, "standup_date": {}, "confidence_pct": {} } },
          "description": "Newest-first prior-run rows; values pass through raw (a malformed confidence_pct skips the row, as in Python)."
        },
        "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "want_adjudication": { "type": "boolean" },
        "dropped_case_ids": { "type": "array", "items": { "type": "string" }, "description": "Pass 2 only: case ids the adjudicator dropped; unknown ids are discarded." }
      }
    },
    "evidence_row": {
      "type": "object",
      "required": ["kind", "key", "title", "url", "repository", "status", "timestamp", "children", "issue_type", "parent_key", "subtask", "ticket_keys"],
      "properties": {
        "kind": { "type": "string" },
        "key": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "repository": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/evidence_row" }, "description": "Commits folded under their PR; one level deep." },
        "issue_type": { "type": "string" },
        "parent_key": { "type": "string" },
        "subtask": { "type": "boolean" },
        "ticket_keys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "category_block": {
      "type": "object",
      "required": ["summary", "links", "count", "evidence"],
      "properties": {
        "summary": { "type": "string", "description": "The deterministic fallback category summary (coverage wording when empty)." },
        "links": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "count": { "type": "integer" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_row" } }
      }
    },
    "member_skeleton": {
      "type": "object",
      "required": ["name", "source", "links", "activity_count", "fallback_summary", "fallback_progress_note", "fallback_outlook", "ticketing", "code", "documentation"],
      "properties": {
        "name": { "type": "string" },
        "source": { "enum": ["inferred", "self-reported", "combined"] },
        "links": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "activity_count": { "type": "integer" },
        "fallback_summary": { "type": "string" },
        "fallback_progress_note": { "type": "string" },
        "fallback_outlook": { "type": "string" },
        "ticketing": { "$ref": "#/$defs/category_block" },
        "code": { "$ref": "#/$defs/category_block", "description": "Evidence rows nest commits under PRs; links/counts keep the flat view." },
        "documentation": { "$ref": "#/$defs/category_block" }
      }
    },
    "practice_signal": {
      "type": "object",
      "required": ["rule", "title", "detail", "evidence", "repeat", "handles"],
      "properties": {
        "rule": { "type": "string" },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "repeat": { "type": "boolean" },
        "handles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "adjudication_case": {
      "type": "object",
      "required": ["case_id", "subject", "branch", "paths", "candidates"],
      "properties": {
        "case_id": { "type": "string" },
        "subject": { "type": "string" },
        "branch": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "candidates": { "type": "array", "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "description": "(key, title, clipped text) triples." }
      }
    },
    "result": {
      "type": "object",
      "required": ["contract_version", "members", "merged", "counts", "total_items", "automation_notices", "category_coverage", "grouped", "blocker_signals", "yesterday", "practices", "progress", "member_skeletons", "fallback_team_summary", "adjudication_cases"],
      "properties": {
        "contract_version": { "const": 1 },
        "members": { "type": "array", "items": { "type": "string" }, "description": "Post-merge: roster entries that were the standup user under another name are gone." },
        "merged": { "type": "array", "items": { "type": "string" } },
        "counts": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 }, "description": "Per-source counts AFTER the roster + automation filters." },
        "total_items": { "type": "integer" },
        "automation_notices": { "type": "array", "items": { "type": "string" } },
        "category_coverage": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "grouped": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/activity_item" } }, "description": "Every member present (possibly empty), MEMBERS order." },
        "blocker_signals": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "description": "Members with no signals ABSENT; members order." },
        "yesterday": { "type": "object", "additionalProperties": { "type": "object" }, "description": "Per-member {summary, blockers, outlook[, corrected][, corrections]}." },
        "practices": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/practice_signal" } }, "description": "Members with no signals ABSENT; members order." },
        "progress": {
          "type": "object",
          "required": ["sprint_day", "sprint_total_days", "confidence_pct", "confidence_label", "confidence_rationale", "confidence_delta", "confidence_trend"],
          "properties": {
            "sprint_day": { "type": "integer" },
            "sprint_total_days": { "type": "integer" },
            "confidence_pct": { "type": "integer" },
            "confidence_label": { "type": "string" },
            "confidence_rationale": { "type": "string" },
            "confidence_delta": { "type": "integer" },
            "confidence_trend": { "type": "string" }
          }
        },
        "member_skeletons": { "type": "array", "items": { "$ref": "#/$defs/member_skeleton" }, "description": "Members order — the deterministic half of every MemberUpdate; Python overlays prose." },
        "fallback_team_summary": { "type": "string" },
        "adjudication_cases": { "type": "array", "items": { "$ref": "#/$defs/adjudication_case" }, "description": "Pass 1 only; [] on pass 2 or when want_adjudication is false." }
      }
    }
  }
}
