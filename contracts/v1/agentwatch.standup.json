{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yeaboi-core/v1/agentwatch.standup.json",
  "title": "agentwatch.standup params and result",
  "description": "The LOCAL half of yeaboi.agent.state.AgentStandupDigest: refresh + session summaries + window totals. The tracker leg (repo_activity, in_flight, tracker coverage notes), all prose (highlights/attention_items/narrative), delivery, history and generated_at stay Python-side and are ALWAYS empty from Go. agents_seen carries session sources only (Python unions in tracker markers). window_start/digest_date are computed by Python (previous-working-day logic is local-timezone- and convention-bound) and travel as params.",
  "$defs": {
    "params": {
      "type": "object",
      "required": ["db_path", "window_start", "digest_date"],
      "properties": {
        "db_path": { "type": "string" },
        "window_start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Inclusive lower bound on ended_at (lexicographic ISO compare)." },
        "digest_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "roots": { "$ref": "agentwatch.refresh.json#/$defs/params/properties/roots" }
      }
    },
    "session_summary": {
      "type": "object",
      "required": ["session_id", "source", "project", "branch", "models", "turns", "cost_usd", "top_tools", "started_at", "ended_at"],
      "properties": {
        "session_id": { "type": "string" },
        "source": { "type": "string" },
        "project": { "type": "string", "description": "The project path's last component (engine._project_label)." },
        "branch": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" }, "description": "Sorted model names." },
        "turns": { "type": "integer" },
        "cost_usd": { "type": "number" },
        "top_tools": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
          "description": "(tool name, count-as-string) pairs, count-descending; ties keep the sorted-by-name order the stored JSON provides."
        },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "digest_date", "window_start", "window_end", "sessions_worked", "total_cost_usd",
        "agents_seen", "session_summaries", "repo_activity", "highlights", "in_flight",
        "attention_items", "narrative", "coverage_notes", "warnings", "generated_at"
      ],
      "properties": {
        "digest_date": { "type": "string" },
        "window_start": { "type": "string" },
        "window_end": { "type": "string", "description": "Equal to digest_date." },
        "sessions_worked": { "type": "integer", "description": "Rollup rows in the window (NOT distinct session ids — mirrors engine)." },
        "total_cost_usd": { "type": "number", "description": "round(sum of per-summary rounded costs, 4), summed in cost-descending summary order." },
        "agents_seen": { "type": "array", "items": { "type": "string" }, "description": "Sorted distinct session sources." },
        "session_summaries": { "type": "array", "items": { "$ref": "#/$defs/session_summary" }, "description": "Cost-descending (stable over ended_at DESC list order)." },
        "repo_activity": { "type": "array", "maxItems": 0 },
        "highlights": { "type": "array", "maxItems": 0 },
        "in_flight": { "type": "array", "maxItems": 0 },
        "attention_items": { "type": "array", "maxItems": 0 },
        "narrative": { "const": "" },
        "coverage_notes": {
          "type": "array",
          "maxItems": 1,
          "items": { "type": "string" },
          "description": "Exactly the deterministic no-local-sessions note when the window is empty, else []."
        },
        "warnings": { "type": "array", "items": { "type": "string" }, "description": "Scan warnings only; Python appends the no-activity and LLM warnings." },
        "generated_at": { "const": "" }
      }
    },
    "result": {
      "type": "object",
      "required": ["contract_version", "stats", "artifact"],
      "properties": {
        "contract_version": { "const": 1 },
        "stats": { "$ref": "agentwatch.refresh.json#/$defs/stats" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
