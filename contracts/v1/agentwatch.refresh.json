{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yeaboi-core/v1/agentwatch.refresh.json",
  "title": "agentwatch.refresh params and result",
  "$defs": {
    "params": {
      "type": "object",
      "required": ["db_path"],
      "properties": {
        "db_path": { "type": "string", "description": "Absolute path to sessions.db" },
        "roots": {
          "description": "Override scan roots (tests/parity). null/omitted = the default ~/.claude/projects root with source claude_code.",
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["source", "root"],
            "properties": {
              "source": { "type": "string" },
              "root": { "type": "string" }
            }
          }
        },
        "reset_cursors": {
          "type": "boolean",
          "default": false,
          "description": "Forget ingest cursors first (the security mode's deep=True re-scan)."
        }
      }
    },
    "stats": {
      "type": "object",
      "description": "Mirror of collector.IngestStats.",
      "required": [
        "files_seen",
        "files_skipped",
        "files_parsed",
        "files_pruned",
        "sessions_upserted",
        "findings_added",
        "malformed_lines",
        "warnings"
      ],
      "properties": {
        "files_seen": { "type": "integer", "minimum": 0 },
        "files_skipped": { "type": "integer", "minimum": 0 },
        "files_parsed": { "type": "integer", "minimum": 0 },
        "files_pruned": { "type": "integer", "minimum": 0 },
        "sessions_upserted": { "type": "integer", "minimum": 0 },
        "findings_added": { "type": "integer", "minimum": 0 },
        "malformed_lines": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "result": {
      "type": "object",
      "required": ["contract_version", "stats"],
      "properties": {
        "contract_version": { "const": 1 },
        "stats": { "$ref": "#/$defs/stats" }
      }
    }
  }
}
