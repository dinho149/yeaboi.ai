{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yeaboi-core/v1/agentwatch.usage.json",
  "title": "agentwatch.usage params and result",
  "description": "The artifact mirrors the deterministic fields of yeaboi.agent.state.AgentUsageReport. insights/recommendations/generated_at/annotations are ALWAYS empty from Go — the Python side writes prose and stamps time. Warnings carry only scan warnings plus the deterministic empty-window note; Python appends LLM warnings.",
  "$defs": {
    "params": {
      "type": "object",
      "required": ["db_path", "window_days", "today"],
      "properties": {
        "db_path": { "type": "string" },
        "window_days": { "type": "integer", "minimum": 1 },
        "project": { "type": "string", "default": "", "description": "Case-insensitive substring filter on the project dir name." },
        "source": { "type": "string", "default": "", "description": "Exact filter on the telemetry source." },
        "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "roots": { "$ref": "agentwatch.refresh.json#/$defs/params/properties/roots" },
        "refresh": { "type": "boolean", "default": true, "description": "Run the collector before aggregating." }
      }
    },
    "model_row": {
      "type": "object",
      "required": ["model", "input_tokens", "output_tokens", "cache_write_tokens", "cache_read_tokens", "calls", "cost_usd", "known_pricing"],
      "properties": {
        "model": { "type": "string" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "cache_write_tokens": { "type": "integer" },
        "cache_read_tokens": { "type": "integer" },
        "calls": { "type": "integer" },
        "cost_usd": { "type": "number" },
        "known_pricing": { "type": "boolean" }
      }
    },
    "breakdown_row": {
      "type": "object",
      "required": ["key", "sessions", "input_tokens", "output_tokens", "cost_usd"],
      "properties": {
        "key": { "type": "string" },
        "sessions": { "type": "integer" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "cost_usd": { "type": "number" }
      }
    },
    "daily_point": {
      "type": "object",
      "required": ["date", "cost_usd", "input_tokens", "output_tokens", "sessions"],
      "properties": {
        "date": { "type": "string" },
        "cost_usd": { "type": "number" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "sessions": { "type": "integer" }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "period_start", "period_end", "session_count", "total_cost_usd",
        "total_input_tokens", "total_output_tokens", "total_cache_write_tokens",
        "total_cache_read_tokens", "unknown_model_cost_share", "pricing_as_of",
        "by_model", "by_project", "by_source", "daily_trend",
        "insights", "recommendations", "warnings", "generated_at"
      ],
      "properties": {
        "period_start": { "type": "string" },
        "period_end": { "type": "string" },
        "session_count": { "type": "integer" },
        "total_cost_usd": { "type": "number" },
        "total_input_tokens": { "type": "integer" },
        "total_output_tokens": { "type": "integer" },
        "total_cache_write_tokens": { "type": "integer" },
        "total_cache_read_tokens": { "type": "integer" },
        "unknown_model_cost_share": { "type": "number" },
        "pricing_as_of": { "type": "string" },
        "by_model": { "type": "array", "items": { "$ref": "#/$defs/model_row" } },
        "by_project": { "type": "array", "items": { "$ref": "#/$defs/breakdown_row" } },
        "by_source": { "type": "array", "items": { "$ref": "#/$defs/breakdown_row" } },
        "daily_trend": { "type": "array", "items": { "$ref": "#/$defs/daily_point" } },
        "insights": { "type": "array", "maxItems": 0 },
        "recommendations": { "type": "array", "maxItems": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "const": "" }
      }
    },
    "result": {
      "type": "object",
      "required": ["contract_version", "stats", "artifact"],
      "properties": {
        "contract_version": { "const": 1 },
        "stats": { "$ref": "agentwatch.refresh.json#/$defs/stats" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
