{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Preact via preact/compat — @yeaboi-ai/design is written against it, so
    // this is what makes its primitives resolve the same here as on the boards.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "react-dom/client": ["./node_modules/preact/compat/client"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"],
      "react": ["./node_modules/preact/compat/"],
      "react-dom": ["./node_modules/preact/compat/"],
      "preact": ["./node_modules/preact"],
      "preact/*": ["./node_modules/preact/*"],
      "@design/*": ["./node_modules/@yeaboi-ai/design/design/*"]
    },

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "electron.vite.config.ts"]
}
