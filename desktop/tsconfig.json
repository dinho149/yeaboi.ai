{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Preact via preact/compat — mirrors frontend/tsconfig.json so modules
    // from @design/@shared resolve identically in both packages.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "react-dom/client": ["./node_modules/preact/compat/client"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"],
      "react": ["./node_modules/preact/compat/"],
      "react-dom": ["./node_modules/preact/compat/"],
      "preact": ["./node_modules/preact"],
      "preact/*": ["./node_modules/preact/*"],
      "@design/*": ["../frontend/src/design/*"],
      "@shared/*": ["../frontend/src/shared/*"]
    },

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "electron.vite.config.ts"]
}
